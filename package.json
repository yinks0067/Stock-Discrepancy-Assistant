{
  "name": "stock-discrepancy-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate": "tsx scripts/generate-data.ts",
    "db:reset": "psql \"$DATABASE_URL\" -f db/schema.sql -f db/load.sql",
    "investigate": "tsx src/cli.ts",
    "eval": "tsx eval/run-eval.ts",
    "eval:baseline": "tsx eval/run-eval.ts --baseline",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "next": "^16.4.6",
    "pg": "^8.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
